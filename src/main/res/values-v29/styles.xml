<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:statusBarColor">#080c14</item>
        <item name="android:enforceNavigationBarContrast">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
    </style>
    <style name="Base.Theme.SplashScreen" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowLayoutInDisplayCutoutMode">1</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="isLightTheme">?android:attr/isLightTheme</item>
    </style>
    <style name="Base.Theme.SplashScreen.Light" parent="@style/Base.Theme.SplashScreen">
    </style>
    <style name="gboard_tts_light" parent="">
        <item name="color">#ebeff1</item>
    </style>
</resources>
